{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSameLine": false,
  "sortPackageJson": false,
  "svelte": {
    "allowShorthand": true,
    "indentScriptAndStyle": true,
    "sortOrder": "scripts-options-markup-styles"
  },
  "ignorePatterns": []
}
